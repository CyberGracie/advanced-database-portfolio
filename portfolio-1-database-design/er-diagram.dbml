// NairaFlow Digital Bank – ER model (MIT 8103 Portfolio 1)

Table customers {
  customer_id int [pk, increment]
  first_name varchar(50) [not null]
  last_name varchar(50) [not null]
  email varchar(100) [unique, not null]
  phone varchar(20) [unique, not null]
  bvn char(11) [unique, not null, note: 'Bank Verification Number']
  date_of_birth date [not null]
  kyc_status varchar(20) [not null, default: 'PENDING']
  created_at timestamp [not null, default: `now()`]
}

Table staff {
  staff_id int [pk, increment]
  full_name varchar(100) [not null]
  email varchar(100) [unique, not null]
  role varchar(30) [not null, note: 'TELLER, OPERATIONS, COMPLIANCE, AUDITOR']
  created_at timestamp [not null, default: `now()`]
}

Table kyc_documents {
  document_id int [pk, increment]
  customer_id int [not null, ref: > customers.customer_id]
  document_type varchar(30) [not null, note: 'NIN, PASSPORT, DRIVERS_LICENCE']
  document_number varchar(50) [not null]
  verified_by int [ref: >? staff.staff_id]
  verified_at timestamp
}

Table account_types {
  account_type_id int [pk, increment]
  type_name varchar(30) [unique, not null, note: 'SAVINGS, CURRENT, WALLET']
  daily_transfer_limit decimal(15,2) [not null]
}

Table accounts {
  account_id int [pk, increment]
  account_number char(10) [unique, not null, note: 'NUBAN']
  customer_id int [not null, ref: > customers.customer_id]
  account_type_id int [not null, ref: > account_types.account_type_id]
  balance decimal(15,2) [not null, default: 0, note: 'Cached; audited against ledger']
  currency char(3) [not null, default: 'NGN']
  status varchar(20) [not null, default: 'ACTIVE']
  opened_at timestamp [not null, default: `now()`]
}

Table transactions {
  transaction_id bigint [pk, increment]
  reference varchar(30) [unique, not null]
  transaction_type varchar(20) [not null, note: 'DEPOSIT, WITHDRAWAL, TRANSFER, REVERSAL']
  amount decimal(15,2) [not null, note: 'Must be > 0']
  status varchar(20) [not null, note: 'PENDING, SUCCESS, FAILED, REVERSED']
  created_at timestamp [not null, default: `now()`]
  completed_at timestamp
}

Table ledger_entries {
  entry_id bigint [pk, increment]
  transaction_id bigint [not null, ref: > transactions.transaction_id]
  account_id int [not null, ref: > accounts.account_id]
  entry_type varchar(6) [not null, note: 'DEBIT or CREDIT']
  amount decimal(15,2) [not null]
  balance_after decimal(15,2) [not null]
  created_at timestamp [not null, default: `now()`]
}

Table transfers {
  transfer_id bigint [pk, increment]
  transaction_id bigint [unique, not null, ref: - transactions.transaction_id]
  source_account_id int [not null, ref: > accounts.account_id]
  destination_account_id int [ref: >? accounts.account_id, note: 'Set for NairaFlow-to-NairaFlow transfers']
  beneficiary_bank_code char(6) [note: 'Set only for interbank transfers']
  beneficiary_account_number char(10) [note: 'Set only for interbank transfers']
  beneficiary_name varchar(100)
  idempotency_key varchar(64) [unique, not null, note: 'Prevents duplicate transfers']
  failure_reason varchar(255)

  Note: 'Each transfer has EITHER destination_account_id (internal) OR beneficiary_bank_code + beneficiary_account_number (interbank), never both.'
}

Table reversals {
  reversal_id bigint [pk, increment]
  original_transaction_id bigint [unique, not null, ref: - transactions.transaction_id]
  reversal_transaction_id bigint [unique, not null, ref: - transactions.transaction_id]
  reason varchar(255) [not null]
  approved_by int [not null, ref: > staff.staff_id]
  reversed_at timestamp [not null, default: `now()`]
}

Table audit_log {
  audit_id bigint [pk, increment]
  table_name varchar(50) [not null]
  record_id bigint [not null]
  action varchar(10) [not null, note: 'INSERT, UPDATE, DELETE']
  old_values json
  new_values json
  performed_by varchar(50) [not null]
  performed_at timestamp [not null, default: `now()`]
}